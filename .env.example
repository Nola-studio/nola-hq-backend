PORT=3001
NODE_ENV=development

# Base de données :
#   - Prod (Railway, …) : DATABASE_URL Postgres (a la priorité).
#   - Dev local : laisse DATABASE_URL vide → fallback SQLite via DB_PATH.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_PATH=./data/nola.sqlite

# Session (cookie chiffré, pattern aligné sur kelasi-backend)
SESSION_COOKIE_NAME=nola_hq_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
# 32 bytes en base64 — `openssl rand -base64 32`
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
