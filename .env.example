PORT=3001
NODE_ENV=development

# Base de données :
#   - Prod (Railway, …) : DATABASE_URL Postgres (a la priorité).
#   - Dev local : laisse DATABASE_URL vide → fallback SQLite via DB_PATH.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_PATH=./data/nola.sqlite

# Ticket attachments — a Railway volume mounts here in prod, plain disk in dev.
ATTACHMENTS_DIR=./data/attachments

# Shared mailbox CC'd on every Studio *task* email (created/assigned/due-soon).
# Not support tickets — see TICKETS_CC_EMAIL below. Empty = no CC.
STUDIO_TICKETS_CC_EMAIL=

# Shared mailbox CC'd on every support *ticket* email (created/assigned).
# Empty = no CC.
TICKETS_CC_EMAIL=

# Session (cookie chiffré, pattern aligné sur kelasi-backend)
SESSION_COOKIE_NAME=nola_hq_session
SESSION_COOKIE_SAMESITE=lax
# Must be "true" in production — boot fails closed otherwise (see env.validation.ts).
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
# 32 bytes en base64 — `openssl rand -base64 32`
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public-facing console URL — used to build the receipt verification link
# embedded in the QR code on receipt PDFs (GET /verify/receipt/:token).
# Required in production — boot fails closed otherwise (see env.validation.ts):
# unset or malformed, every receipt ships with a QR pointing nowhere, and
# nothing else would surface that.
PUBLIC_APP_URL=http://localhost:5173

# Web Push (PWA installée) — générer via `bunx web-push generate-vapid-keys`.
# Sans ces clés, le push est désactivé proprement (aucun autre impact).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ── GitHub App (ENG-06 / ENG-08) ──────────────────────────────────────────
# Sans ces variables, l'intégration se déclare « non configurée » et l'écran
# des dépôts le dit calmement — rien d'autre n'est affecté.
#
# App ID et slug se lisent sur la page de l'App ; ce ne sont pas des secrets.
GITHUB_APP_ID=4831187
GITHUB_APP_SLUG=nolaahq
#
# La clé privée (.pem téléchargé par « Generate a private key »). Trois formes
# acceptées, parce que les plateformes ne s'accordent pas sur le passage d'un
# PEM multi-lignes dans une variable :
#   - le PEM tel quel, avec ses vrais sauts de ligne ;
#   - le même avec des `\n` littéraux ;
#   - le même encodé en base64 (`base64 -w0 nolaahq.pem`).
# Ne jamais committer cette valeur.
GITHUB_APP_PRIVATE_KEY=
#
# Surcharge l'API GitHub — pour GitHub Enterprise, ou un serveur factice en
# recette. Défaut : https://api.github.com
GITHUB_API_URL=
#
# Le secret du webhook, tel que saisi dans la GitHub App (`openssl rand -hex 32`).
# Sans lui, l'endpoint /public/v1/webhooks/github refuse TOUTE livraison —
# absence de secret ne veut pas dire « accepter tout le monde ».
GITHUB_WEBHOOK_SECRET=
